{
  "$schemaNote": "P0 machine-readable companion to docs/delivery/p0-contract.md. Not a wrangler schema.",
  "id": "life-circuit-chengwan-p0",
  "title": {
    "zhHant": "生命迴路：澄灣",
    "en": "Life Circuit: Chengwan"
  },
  "version": "2026-08-15-p0",
  "localeDefault": "zh-Hant",
  "liveDeployRequested": false,
  "localUrl": "http://127.0.0.1:8787",
  "authorities": [
    "team-science-safety-signoff-if-present",
    "Life_Circuit_Chengwan_Full_Game_Script_v1",
    "legacy-20_SOURCE_AND_CLAIM_REGISTER-safety-wording-only",
    "legacy-GDD-TDD-if-no-conflict"
  ],
  "stack": {
    "language": "TypeScript strict",
    "bundler": "Vite",
    "renderer": "Three.js",
    "hud": "semantic-dom",
    "backend": "none",
    "accounts": false,
    "analytics": false,
    "save": "localStorage",
    "saveKey": "life-circuit-chengwan.save.v1",
    "schemaVersion": 1
  },
  "cloudflare": {
    "configFile": "wrangler.jsonc",
    "name": "life-circuit-chengwan",
    "workers_dev": true,
    "compatibility_date": "2026-08-15",
    "main": "src/worker.ts",
    "assets": {
      "directory": "./dist",
      "not_found_handling": "single-page-application",
      "binding": "ASSETS",
      "run_worker_first": ["/health", "/health/*"],
      "html_handling": "omit-use-default-auto-trailing-slash"
    },
    "forbiddenBindings": ["kv_namespaces", "d1_databases", "r2_buckets", "queues", "secrets", "analytics_engine_datasets"],
    "observability": {
      "workersLogsOptional": true,
      "webAnalytics": false,
      "collectWorkshopPii": false
    },
    "headers": {
      "mechanism": "public/_headers copied to dist/_headers; worker Response for /health",
      "indexHtmlCache": "no-cache",
      "hashedAssetsCache": "public, max-age=31556952, immutable",
      "defaultWorkersAssetCache": "public, max-age=0, must-revalidate + ETag",
      "security": [
        "X-Content-Type-Options: nosniff",
        "Referrer-Policy: strict-origin-when-cross-origin",
        "CSP allow self + WebGL + wasm-unsafe-eval + blob workers",
        "COOP/COEP off unless Three.js smoke passes"
      ]
    },
    "health": {
      "path": "/health",
      "gameState": false,
      "pii": false
    },
    "localParity": "npx wrangler dev --port 8787 after vite build",
    "vitePreview": "extra-not-a-substitute",
    "liveDeploy": {
      "allowed": false,
      "requires": ["LIVE_DEPLOY_REQUESTED=true", "wrangler whoami succeeds"],
      "blocker": "LIVE_DEPLOY_REQUESTED is false; stop after dry-run"
    },
    "docsFetched": [
      "https://developers.cloudflare.com/workers/static-assets/",
      "https://developers.cloudflare.com/workers/static-assets/routing/single-page-application/",
      "https://developers.cloudflare.com/workers/wrangler/configuration/",
      "https://developers.cloudflare.com/workers/static-assets/headers/"
    ]
  },
  "scope": {
    "in": [
